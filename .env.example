# bancolombia-cli configuration (all optional — sensible defaults are built in).
#
# Copy to `.env` only if you need to override the defaults. Never commit `.env`;
# it is already listed in .gitignore.

# Where the session (cookies / tokens) is persisted. Defaults to ~/.bancolombia
# BANCOLOMBIA_HOME=~/.bancolombia

# Port for the local REST API started by `bancolombia server`.
# BANCOLOMBIA_API_PORT=3200

# Base URL of the Bancolombia personal-banking site that the browser login
# (`bancolombia login`) automates. Override only if the portal URL changes.
# BANCOLOMBIA_PORTAL_URL=https://sucursalpersonas.transaccionesbancolombia.com

# Headless proxy endpoint used by `bancolombia connect <user> <pin> [api-url]`.
# When you pass an api-url on the command line it takes precedence over this.
# BANCOLOMBIA_API_URL=

# Run the browser login with a visible window (useful for debugging / first
# login / solving captchas). Defaults to false (headless).
# BANCOLOMBIA_HEADFUL=false
